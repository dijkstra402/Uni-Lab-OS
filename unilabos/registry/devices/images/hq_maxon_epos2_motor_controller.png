<body>
    <div class="flex-box">
    <div class="container">
        <div class="head">
            <svg width="140" height="26" viewBox="0 0 140 26" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd"
