                    fill="#DB0000" />
            </svg>
            <p class="error">Error E1120</p>
        </div>
        <div class="content">
            <h1>Oops... something went wrong</h1>
            <img class="image" alt="technical sketch rotated" src=" data:image/png;base64,">
            <div class="paragraph">
                <p>Please try again later.</p>
                <p lang="de">Versuchen Sie es später erneut.</p>
            </div>
        </div>
    </div>
</div>
</body>

</html>