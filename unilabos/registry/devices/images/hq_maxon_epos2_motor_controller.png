<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Maxon 500 Error Page</title>
    <style>
        @font-face {
            font-family: 'Suisse Intl';
            src: local('Suisse Intl'), url(/errorpages/SuisseIntlMaxon-SemiBold.woff2) format('woff2');
        }

        body {
            padding: 0px 16px;
            max-width: 1240px;
            margin: 40px auto;
            font-size: 16px;
            box-sizing: border-box;
            font-family: 'Suisse Intl', 'Arial', 'Helvetica', 'sans-serif';
        }

        .flex-box{
            display: -webkit-flex;
            justify-content: center;
        }

        .container {
            display: flex;
            align-items: stretch;
            flex-direction: column;
        }

        h1 {
            font-size: 50px;
            font-weight: 800;
            line-height: 53px;
            margin: 0;
        }

        .paragraph {
            margin: 0;
            font-size: 14px;
            line-height: 21px;
            font-weight: 800;
            padding-bottom: 0;
        }

        p {
            margin: 0;
        }

        .error {
            font-weight: 600;
            font-size: 12px;
            line-height: 16px;
            color: rgb(119, 118, 118);
        }

        .head {
            margin-bottom: 118px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .content {
            display: block;
            grid-template-columns: 50% 50%;
            grid-template-rows: auto 1fr;
        }

        .image {
            grid-column-start: 2;
            grid-column-end: span 1;
            grid-row-start: 1;
            grid-row-end: span 2;
            margin-top: 24px;
        }

        .content img {
            width: 100%;
        }

        .content h1 {
            margin: 0;
            padding: 0;
        }

        .content p {
            margin: 0;
            font-weight: 800;
        }

        .content p:first-child {
            margin-top: 24px;
        }

        @media only screen and (min-width: 768px) {
            .content {
                display: grid;
            }

            h1 {
                font-size: 70px;
                line-height: 74px;
            }

            .paragraph {
                font-size: 24px;
                line-height: 34px;
            }

            .error {
                font-size: 14px;
                line-height: 21px;
            }

            .image {
                margin-top: -60px;
            }

        }
    </style>

