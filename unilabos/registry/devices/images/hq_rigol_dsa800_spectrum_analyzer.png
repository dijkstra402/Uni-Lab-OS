</div>
<div class="swiper_arrow is-next is-industry-nav">
<div class="ic_arrow-wrap ">
<div class="ic_arrow-svg-wrap is-next"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewbox="0 0 4 6" fill="none" class="ic_arrow-svg">
<path d="M0.5 0.916585L3 2.99992L0.5 5.08325" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
