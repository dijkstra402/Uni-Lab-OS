<div class="swiper-slide is-industry-nav swiper-slide-active">
<div class="swiper-slide-content">
<div class="industry_slide-nav">Power electronics</div>
</div>
</div>
</div>
</div>
<div class="swiper_arrow-list isindustry-nav">
<div class="swiper_arrow is-prev is-industry-nav">
