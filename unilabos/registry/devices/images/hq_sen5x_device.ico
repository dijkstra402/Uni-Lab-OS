 32 14.3 32 32z"></path></svg></button></nav><main><article><div class="build-container "><section class="tw-group/module tw-relative spacer-no-space bg-white tw-overflow-x-hidden" data-module-type="HERO"><header id="hero" class="hero bg-dark "><div class="mask "></div><div class="container tw-relative tw-z-10"><div class="row"><section class="Hero_hero__content__f0_ZE col-12"><h1 class="hero__title hero-header">Smart sensor solutions</h1><section class="row align-items-center"><div class="col-12 col-md-8"><p class="hero__lead">Increase health, improve energy efficiency, ensure safety &amp; comfort – for a better tomorrow.</p></div><div class="col-12 col-md-4 d-grid d-md-flex justify-content-md-end"><a class="btn btn-lg btn-primary mt-5 mt-md-0" href="/products/catalog">Product catalog</a></div></section></section><section class="Hero_items__container__R8_on col-12 tw-pb-7"><div class="slick-slider Hero_slider__6mJ5b tw-group slick-initialized" dir="ltr"><button type="button" class="slick-arrow slick-prev  tw-absolute tw-z-10 tw-h-[40px] tw-w-[40px] tw--translate-y-1/2 tw-cursor-pointer tw-rounded-full tw-border tw-border-solid tw-border-gray-1 tw-bg-white tw-text-base tw-text-black tw-shadow-lg tw-transition-opacity tw-duration-300 before:tw-hidden tw-hidden md:tw-opacity-0 group-hover:md:tw-opacity-100" style="display:block" disabled=""><svg aria-hidden="true" focusable="false" data-prefix="fas" data-icon="arrow-left" class="svg-inline--fa fa-arrow-left " role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><path fill="currentColor" d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.2 288 416 288c17.7 0 32-14.3 32-32s-14.3-32-32-32l-306.7 0L214.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z"></path></svg><span class="tw-sr-only">Previous</span></button><div class="slick-list"><div class="slick-track" style="width:125%;left:0%"><div data-index="0" class="slick-slide slick-active slick-current" tabindex="-1" aria-hidden="false" style="outline:none;width:20%"><div><a class="Hero_hero__card__o_B4b d-flex flex-column bg-dark tw-group/card" target="_blank" tabindex="-1" style="width:100%;display:inline-block" href="https://sensirion.com/company/news/press-releases-and-news/article/sensirion-launches-scd43-co-sensor-with-stringent-building-standard-compability"><h2 class="mb-3 font-h3 pe-3xl-3 group-hover/card:tw-underline">The SCD43: High-accuracy CO₂ sensing, now globally available</h2><p class="Hero_card__lead__3gLQs mb-3 d-none d-md-block">The new SCD43 CO₂ sensor delivers best-in-class accuracy in a compact, easy-to-integrate package for HVAC and indoor air quality applications.</p><p class="tw-me-auto tw-mt-auto"><span class="app-link tw-group/teaser tw-inline-flex tw-items-center tw-border-b-2 tw-border-solid tw-duration-100 tw-border-sensirion-brand hover:tw-border-transparent"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="4 4 16 16" class="tw-me-2 tw-shrink-0 tw-text-inherit"><path stroke="currentColor" stroke-linejoin="round" stroke-width="2" d="m7 17 9-9"></path><path stroke="currentColor" stroke-linecap="square" stroke-width="2" d="M8 7h9v9"></path></svg>Learn more</span></p></a></div></div><div data-index="1" class="slick-slide slick-active" tabindex="-1" aria-hidden="false" style="outline:none;width:20%"><div><a class="Hero_hero__card__o_B4b d-flex flex-column bg-dark tw-group/card" target="_blank" tabindex="-1" style="width:100%;display:inline-block" href="https://attendee.gotowebinar.com/register/3022592001086779742"><h2 class="mb-3 font-h3 pe-3xl-3 group-hover/card:tw-underline">The future of refrigerant leak detection</h2><p class="Hero_card__lead__3gLQs mb-3 d-none d-md-block">Learn how to meet new A2L refrigerant requirements with safe, UL-aligned leak detection in our on-demand webinar.</p><p class="tw-me-auto tw-mt-auto"><span class="app-link tw-group/teaser tw-inline-flex tw-items-center tw-border-b-2 tw-border-solid tw-duration-100 tw-border-sensirion-brand hover:tw-border-transparent"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="4 4 16 16" class="tw-me-2 tw-shrink-0 tw-text-inherit"><path stroke="currentColor" stroke-linejoin="round" stroke-width="2" d="m7 17 9-9"></path><path stroke="currentColor" stroke-linecap="square" stroke-width="2" d="M8 7h9v9"></path></svg>Watch now</span></p></a></div></div><div data-index="2" class="slick-slide slick-active" tabindex="-1" aria-hidden="false" style="outline:none;width:20%"><div><a class="Hero_hero__card__o_B4b d-flex flex-column bg-dark tw-group/card" target="_blank" tabindex="-1" style="width:100%;display:inline-block" href="https://sensirion.com/company/news/press-releases-and-news/article/sensirion-launches-next-generation-sgm5304-gas-meter-module-future-ready-performance-in-the-same-compact-design"><h2 class="mb-3 font-h3 pe-3xl-3 group-hover/card:tw-underline">SGM5304: Next-gen gas meter module with same compact design</h2><p class="Hero_card__lead__3gLQs mb-3 d-none d-md-block">Our brand new SGM5304 is a future-ready gas meter module with low power consumption and built for a lifetime up to 25 years.</p><p class="tw-me-auto tw-mt-auto"><span class="app-link tw-group/teaser tw-inline-flex tw-items-center tw-border-b-2 tw-border-solid tw-duration-100 tw-border-sensirion-brand hover:tw-border-transparent"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="4 4 16 16" class="tw-me-2 tw-shrink-0 tw-text-inherit"><path stroke="currentColor" stroke-linejoin="round" stroke-width="2" d="m7 17 9-9"></path><path stroke="currentColor" stroke-linecap="square" stroke-width="2" d="M8 7h9v9"></path></svg>Learn more</span></p></a></div></div><div data-index="3" class="slick-slide slick-active" tabindex="-1" aria-hidden="false" style="outline:none;width:20%"><div><a class="Hero_hero__card__o_B4b d-flex flex-column bg-dark tw-group/card" target="auto" tabindex="-1" style="width:100%;display:inline-block" href="/forms/smart-inhaler-starter-package"><h2 class="mb-3 font-h3 pe-3xl-3 group-hover/card:tw-underline">Interested in building a smart inhaler?</h2><p class="Hero_card__lead__3gLQs mb-3 d-none d-md-block">Kick-start your project with our starter package, including a STEP model and a practical example.</p><p class="tw-me-auto tw-mt-auto"><span class="app-link tw-group/teaser tw-inline-flex tw-items-center tw-border-b-2 tw-border-solid tw-duration-100 tw-border-sensirion-brand hover:tw-border-transparent">Learn more<svg aria-hidden="true" focusable="false" data-prefix="fas" data-icon="arrow-right" class="svg-inline--fa fa-arrow-right tw-ms-2 tw-shrink-0 tw-p-1 tw-transition-transform tw-duration-500 tw-ease-in-out group-hover/teaser:tw-translate-x-[5px]" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><path fill="currentColor" d="M438.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-160-160c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L338.8 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l306.7 0L233.4 393.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l160-160z"></path></svg></span></p></a></div></div><div data-index="4" class="slick-slide" tabindex="-1" aria-hidden="true" style="outline:none;width:20%"><div><a class="Hero_hero__card__o_B4b d-flex flex-column bg-dark tw-group/card" target="_blank" tabindex="-1" style="width:100%;display:inline-block" href="https://scom.ly/noeK3Wp"><h2 class="mb-3 font-h3 pe-3xl-3 group-hover/card:tw-underline">New specialist article on gas purging</h2><p class="Hero_card__lead__3gLQs mb-3 d-none d-md-block">Gas purging ensures clean environments and high product quality. Sensirion’s MFCs, like SFC5500 and SFC6000D, offer precision and efficiency.</p><p class="tw-me-auto tw-mt-auto"><span class="app-link tw-group/teaser tw-inline-flex tw-items-center tw-border-b-2 tw-border-solid tw-duration-100 tw-border-sensirion-brand hover:tw-border-transparent"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="4 4 16 16" class="tw-me-2 tw-shrink-0 tw-text-inherit"><path stroke="currentColor" stroke-linejoin="round" stroke-width="2" d="m7 17 9-9"></path><path stroke="currentColor" stroke-linecap="square" stroke-width="2" d="M8 7h9v9"></path></svg>Download here</span></p></a></div></div></div></div><button type="button" class="slick-arrow slick-next tw-absolute tw-z-10 tw-h-[40px] tw-w-[40px] tw--translate-y-1/2 tw-cursor-pointer tw-rounded-full tw-border tw-border-solid tw-border-gray-1 tw-bg-white tw-text-base tw-text-black tw-shadow-lg tw-transition-opacity tw-duration-300 before:tw-hidden md:tw-opacity-0 group-hover:md:tw-opacity-100" style="display:block"><svg aria-hidden="true" focusable="false" data-prefix="fas" data-icon="arrow-right" class="svg-inline--fa fa-arrow-right " role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><path fill="currentColor" d="M438.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-160-160c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L338.8 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l306.7 0L233.4 393.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l160-160z"></path></svg><span class="tw-sr-only">Next</span></button></div></section></div></div><div class="hero__visual"><div class="HeroWrapper_video__zhpDd"><figure><video src="https://storage.googleapis.com/com-sensirion-development/portfolio/category/visual/5f083160-af1b-4a57-b394-798cb02d8b59.mp4" autoPlay="" controlsList="nodownload" loop="" muted="" playsInline="" poster="/_next/static/media/hero-frame-SAG.ab2dddb8.webp"></video></figure></div></div></header></section><section class="tw-group/module tw-relative spacer-top-md spacer-bottom-md bg-white tw-overflow-x-hidden" data-module-type="CTA"><div class="CTA_cta___qO2F"><div class="container CTA_cta--wrapper__nQxLh"><div class="row "><div class="col-12 CTA_cta--visual-container__0bgNw align-self-center position-relative col-md-6"><figure class=""><img alt="No alternate text provided" loading="lazy" width="1920" height="1080" decoding="async" data-nimg="1" class="tw-object-cover" style="color:transparent;aspect-ratio:1.7777777777777777" srcSet="/_next/image?url=https%3A%2F%2Fsensirion.com%2Fmedia%2Fmedia%2Fimage%2F01A9B7D6%2F6871010B.webp&amp;w=1920&amp;q=75 1x, /_next/image?url=https%3A%2F%2Fsensirion.com%2Fmedia%2Fmedia%2Fimage%2F01A9B7D6%2F6871010B.webp&amp;w=3840&amp;q=75 2x" src="/_next/image?url=https%3A%2F%2Fsensirion.com%2Fmedia%2Fmedia%2Fimage%2F01A9B7D6%2F6871010B.webp&amp;w=3840&amp;q=75"/></figure></div><div class="col-12 CTA_cta--info-container__aoH90 mx-auto col-md-6 col-xl-4 col-3xl-5 tw-items-start"><span v-if="tag" class="font-tag"></span><h2 class="font-teaser-title">Energy transition</h2><p class="font-body1 mb-4 mb-md-5-5">Net zero requires low-emission technologies like sensors to support infrastructural challenges faced when tackling the transition to cleaner energy-generating assets.</p><a target="_self" class="app-link tw-group/teaser tw-inline-flex tw-items-center tw-border-b-2 tw-border-solid tw-duration-100 tw-border-sensirion-brand hover:tw-border-sensirion-brand" href="/products/product-insights/trend-topics/energy-transition">Learn more<svg aria-hidden="true" focusable="false" data-prefix="fas" data-icon="arrow-right" class="svg-inline--fa fa-arrow-right tw-ms-2 tw-shrink-0 tw-p-1 tw-transition-transform tw-duration-500 tw-ease-in-out group-hover/teaser:tw-translate-x-[5px]" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><path fill="currentColor" d="M438.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-160-160c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L338.8 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l306.7 0L233.4 393.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l160-160z"></path></svg></a></div></div></div></div></section><section class="tw-group/module tw-relative spacer-top-sm spacer-bottom-md bg-white tw-overflow-x-hidden" data-module-type="CTA"><div class="CTA_cta___qO2F"><div class="container CTA_cta--wrapper__nQxLh"><div class="row flex-md-row-reverse"><div class="col-12 CTA_cta--visual-container__0bgNw align-self-center position-relative col-md-6"><figure class=""><img alt="No alternate text provided" loading="lazy" width="1920" height="1080" decoding="async" data-nimg="1" class="tw-object-cover" style="color:transparent;aspect-ratio:1.7777777777777777" srcSet="/_next/image?url=https%3A%2F%2Fsensirion.com%2Fmedia%2Fmedia%2Fimage%2FA1F9C2CA%2F6981C5CA.webp&amp;w=1920&amp;q=75 1x, /_next/image?url=https%3A%2F%2Fsensirion.com%2Fmedia%2Fmedia%2Fimage%2FA1F9C2CA%2F6981C5CA.webp&amp;w=3840&amp;q=75 2x" src="/_next/image?url=https%3A%2F%2Fsensirion.com%2Fmedia%2Fmedia%2Fimage%2FA1F9C2CA%2F6981C5CA.webp&amp;w=3840&amp;q=75"/></figure></div><div class="col-12 CTA_cta--info-container__aoH90 mx-auto col-md-6 col-xl-4 col-3xl-5 tw-items-start"><span v-if="tag" class="font-tag"></span><h2 class="font-teaser-title">Bernoulli ring based airflow measurement</h2><p class="font-body1 mb-4 mb-md-5-5">By combining the Bernoulli principle with our high-precision SDP8xx differential pressure sensors, we can measure air mass flow in blowers and centrifugal fans without obstructing the airflow.</p><a target="_blank" rel="noopener noreferrer" class="app-link tw-group/teaser tw-inline-flex tw-items-center tw-border-b-2 tw-border-solid tw-duration-100 tw-border-sensirion-brand hover:tw-border-sensirion-brand" href="https://sensirion.com/bernoulli"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="4 4 16 16" class="tw-me-2 tw-shrink-0 tw-text-inherit"><path stroke="currentColor" stroke-linejoin="round" stroke-width="2" d="m7 17 9-9"></path><path stroke="currentColor" stroke-linecap="square" stroke-width="2" d="M8 7h9v9"></path></svg>Learn more</a></div></div></div></div></section><section class="tw-group/module tw-relative spacer-top-md spacer-bottom-md bg-white tw-overflow-x-hidden" data-module-type="PRODUCT_SLIDER" aria-labelledby="featur